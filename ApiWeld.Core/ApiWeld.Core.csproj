<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>ApiWeld.Core</PackageId>
    <Description>Normalizes an OpenAPI description so that generated clients are small and mappable: collapses unions, merges duplicate component schemas, and canonicalizes formats.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>openapi;codegen;schema</PackageTags>
    <RepositoryUrl>https://github.com/daemogar/apiweld</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="ApiWeld.Tests" />
  </ItemGroup>

</Project>
